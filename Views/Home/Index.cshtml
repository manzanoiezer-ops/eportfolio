@model List<Project>
@{
    ViewData["Title"] = "Home";
}

<section class="hero">
    <h1 class="hero-heading">
        <span class="line-regular">Full-Stack Developer.</span>
        <span class="line-bold">Virtual World Builder.</span>
    </h1>

    <div class="hero-type-stage">
        <span class="hero-tag-chip chip-a">ASP.NET &middot; Postgres</span>

        <div class="hero-bigtype" aria-hidden="true">
            <span class="bigtype outline">BUILD</span>
            <span class="bigtype solid">WORLDS</span>
        </div>

        <span class="hero-tag-chip chip-b">Three.js &middot; A-Frame</span>

        <div class="hero-visual">
            <div class="hero-canvas-wrap">
                <canvas id="hero-scene"></canvas>
            </div>
        </div>
    </div>

    <div class="hero-bottom">
        <div class="hero-copy">
            <p>I design and build full-stack systems and walkable 3D experiences &mdash; from government data platforms to WebXR museum tours.</p>
            <div class="btn-group">
                <a class="btn" asp-controller="Projects" asp-action="Index">View My Work</a>
                <a class="btn btn-outline" asp-controller="Home" asp-action="Contact">Contact Me</a>
            </div>
        </div>
    </div>

    <div class="social-rail">
        <a href="https://github.com/manzanoiezer-ops" target="_blank" rel="noopener" aria-label="GitHub">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
                <path d="M12 .5C5.73.5.5 5.73.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.28-.01-1.02-.02-2-3.2.7-3.88-1.54-3.88-1.54-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.75 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.68 0-1.25.45-2.28 1.18-3.08-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 5.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.58.23 2.75.11 3.04.73.8 1.18 1.83 1.18 3.08 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14 0 1.55-.01 2.79-.01 3.17 0 .31.21.68.8.56C20.21 21.38 23.5 17.08 23.5 12 23.5 5.73 18.27.5 12 .5Z"/>
            </svg>
        </a>
        <a href="https://www.linkedin.com/in/iezer-joshua-manzano-056490358" target="_blank" rel="noopener" aria-label="LinkedIn">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
                <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.38-1.85 3.61 0 4.27 2.38 4.27 5.47v6.27ZM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14ZM7.12 20.45H3.56V9h3.56v11.45Z"/>
            </svg>
        </a>
        <a href="https://mail.google.com/mail/?view=cm&fs=1&to=manzano.iezer@gmail.com" target="_blank" rel="noopener" aria-label="Email">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2.5" y="4.5" width="19" height="15" rx="2"/>
                <path d="m3 6 9 7 9-7"/>
            </svg>
        </a>
    </div>

    <div class="scroll-cue">
        <span class="scroll-icon" aria-hidden="true"></span>
        <span>Scroll to explore</span>
    </div>
</section>

<section class="whoami">
    <div class="whoami-inner">
        <div class="whoami-photo reveal reveal-left">
            <img src="~/images/profile/headshot.jpg" alt="Iezer Joshua S. Manzano" />
        </div>
        <div class="whoami-content reveal reveal-right d1">
            <h2>Who Am I</h2>
            <p class="whoami-lead">
                I'm a full-stack developer who builds software by mastering every layer that powers it. Handling a project end-to-end from PostgreSQL schemas and ASP.NET backend logic to interactive Three.js and A-Frame interfaces isn't just about versatility for me. It's how I gain complete architectural clarity and build stronger connective tissue across the whole stack.
            </p>
            <p>
                Currently, I apply this hands-on approach as a Computer Programmer I at PHilMech (Philippine Center for Postharvest Development and Mechanization). I'm building a Virtual Biobank for Stored Product Arthropods, combining a robust data warehouse with a fully explorable 3D museum. Managing both the underlying data structure and the walkable visual environment allows me to treat backend data integrity and 3D web performance as two sides of the exact same system.
            </p>
        </div>
    </div>
</section>

<section class="stack">
    <h2>Skills &amp; Tools</h2>
    <div class="stack-grid">
        <div class="stack-group reveal reveal-zoom">
            <span class="stack-group-label">Backend &amp; data</span>
            <div class="stack-chips">
                <div class="stack-chip"><span class="stack-mark">A#</span><span class="stack-name">ASP.NET Core</span></div>
                <div class="stack-chip"><span class="stack-mark">Pg</span><span class="stack-name">PostgreSQL</span></div>
                <div class="stack-chip"><span class="stack-mark">My</span><span class="stack-name">MySQL</span></div>
                <div class="stack-chip"><span class="stack-mark">Php</span><span class="stack-name">PHP</span></div>
            </div>
        </div>
        <div class="stack-group reveal reveal-zoom d1">
            <span class="stack-group-label">3D &amp; WebXR</span>
            <div class="stack-chips">
                <div class="stack-chip"><span class="stack-mark">3js</span><span class="stack-name">Three.js</span></div>
                <div class="stack-chip"><span class="stack-mark">A-F</span><span class="stack-name">A-Frame</span></div>
            </div>
        </div>
        <div class="stack-group reveal reveal-zoom d2">
            <span class="stack-group-label">Frontend</span>
            <div class="stack-chips">
                <div class="stack-chip"><span class="stack-mark">H5</span><span class="stack-name">HTML5</span></div>
                <div class="stack-chip"><span class="stack-mark">C3</span><span class="stack-name">CSS3</span></div>
                <div class="stack-chip"><span class="stack-mark">JS</span><span class="stack-name">JavaScript</span></div>
            </div>
        </div>
        <div class="stack-group reveal reveal-zoom d3">
            <span class="stack-group-label">Systems</span>
            <div class="stack-chips">
                <div class="stack-chip"><span class="stack-mark">Lx</span><span class="stack-name">Linux (CentOS, Ubuntu)</span></div>
            </div>
        </div>
    </div>
</section>

<div class="section-divider" aria-hidden="true"><span class="mark"></span></div>

<section class="services">
    <h2>What I Do</h2>
    <div class="grid">
        <div class="project-card reveal reveal-flip">
            <h3>Full-Stack Web Systems</h3>
            <p>Backend logic, schema design, and data-driven platforms built on ASP.NET Core, PostgreSQL, MySQL, and PHP.</p>
        </div>
        <div class="project-card reveal reveal-flip d1">
            <h3>Interactive 3D &amp; WebXR</h3>
            <p>Walkable, explorable 3D experiences built with Three.js and A-Frame &mdash; from museum tours to visual data exploration.</p>
        </div>
        <div class="project-card reveal reveal-flip d2">
            <h3>Deployment &amp; Systems</h3>
            <p>Setting up and maintaining reliable environments on Linux (CentOS, Ubuntu), from server configuration to hosting the finished platform.</p>
        </div>
    </div>
</section>

<div class="section-divider" aria-hidden="true"><span class="mark"></span></div>

<section class="showcase">
    <div class="showcase-inner">
        <div class="showcase-copy reveal reveal-left">
            <h2>See It Up Close</h2>
            <p>
                A live, interactive scan of <em>Sitophilus&nbsp;oryzae</em> (rice weevil) &mdash; one of the
                specimens catalogued in the Virtual Biobank. Same model, same rendering pipeline that powers
                the full
                <a asp-controller="Projects" asp-action="Details" asp-route-slug="virtual-biobanking">museum tour</a>,
                just dropped straight into this page.
            </p>
            <p class="showcase-hint">Drag to rotate &middot; Scroll to zoom</p>
            <button id="showcase-rotate-toggle" class="btn btn-outline showcase-toggle" type="button">Auto-rotate</button>
        </div>
        <div class="showcase-viewer reveal reveal-pop d1">
            <div id="showcase-frame" class="showcase-frame">
                <canvas id="showcase-canvas"></canvas>
                <div id="showcase-loader" class="showcase-loader">Loading specimen&hellip;</div>
                <div class="showcase-plaque">
                    <span class="plaque-eyebrow">Specimen</span>
                    <span class="plaque-name">Sitophilus oryzae</span>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="section-divider" aria-hidden="true"><span class="mark"></span></div>

<section class="featured">
    <h2>Featured Project</h2>
    @{ var i = 0; }
    @foreach (var project in Model)
    {
        var delayClass = i % 3 == 0 ? "" : i % 3 == 1 ? "d1" : "d2";
        i++;
        <div class="featured-card reveal reveal-skew @delayClass">
            @if (!string.IsNullOrEmpty(project.CoverImage))
            {
                <img class="card-image" src="@project.CoverImage" alt="@project.Title cover" />
            }
            <h3>@project.Title</h3>
            <p>@project.Summary</p>
            <div class="tags">
                @foreach (var tech in project.TechStack)
                {
                    <span class="tag">@tech</span>
                }
            </div>
            <a asp-controller="Projects" asp-action="Details" asp-route-slug="@project.Slug">
                Read the case study
            </a>
        </div>
    }
</section>
