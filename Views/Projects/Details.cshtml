@model Project
@{
    ViewData["Title"] = Model.Title;
}

<article class="case-study">
    @if (!string.IsNullOrEmpty(Model.CoverImage))
    {
        <img class="case-study-banner reveal reveal-zoom" src="@Model.CoverImage" alt="@Model.Title cover" />
    }
    <h1 class="reveal reveal-left">@Model.Title</h1>
    <p class="summary reveal reveal-left d1">@Model.Summary</p>

    <div class="tags reveal d2">
        @foreach (var tech in Model.TechStack)
        {
            <span class="tag">@tech</span>
        }
    </div>

    @if (!string.IsNullOrEmpty(Model.EmbedUrl))
    {
        <div class="embed-frame reveal reveal-pop">
            <iframe src="@Model.EmbedUrl" title="@Model.Title live demo" allowfullscreen></iframe>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.Problem))
    {
        <h2 class="reveal reveal-left">Problem</h2>
        <p class="reveal reveal-left d1">@Model.Problem</p>
    }

    @if (!string.IsNullOrEmpty(Model.RoleAndStack))
    {
        <h2 class="reveal reveal-right">Role &amp; Stack</h2>
        <p class="reveal reveal-right d1">@Model.RoleAndStack</p>
    }

    @if (Model.Highlights.Any())
    {
        <h2 class="reveal reveal-flip">Technical Highlights</h2>
        <ul class="reveal reveal-flip d1">
            @foreach (var item in Model.Highlights)
            {
                <li>@item</li>
            }
        </ul>
    }

    @if (Model.Challenges.Any())
    {
        <h2 class="reveal reveal-flip">Challenges Solved</h2>
        <ul class="reveal reveal-flip d1">
            @foreach (var item in Model.Challenges)
            {
                <li>@item</li>
            }
        </ul>
    }

    @if (!string.IsNullOrEmpty(Model.Result))
    {
        <h2 class="reveal reveal-zoom">Result</h2>
        <p class="reveal reveal-zoom d1">@Model.Result</p>
    }

    @if (Model.GalleryImages.Any())
    {
        <h2 class="reveal">Gallery</h2>
        <div class="case-study-gallery">
            @{ var gi = 0; }
            @foreach (var img in Model.GalleryImages)
            {
                var gDelay = gi % 3 == 0 ? "" : gi % 3 == 1 ? "d1" : "d2";
                gi++;
                <a href="@img" target="_blank" class="case-study-gallery-item reveal reveal-clip @gDelay">
                    <img src="@img" alt="@Model.Title screenshot" loading="lazy" />
                </a>
            }
        </div>
    }

    <div class="links reveal reveal-pop">
        @if (!string.IsNullOrEmpty(Model.RepoUrl))
        {
            <a href="@Model.RepoUrl" target="_blank">View Code</a>
        }
        @if (!string.IsNullOrEmpty(Model.DemoUrl))
        {
            <a href="@Model.DemoUrl" target="_blank">Live Demo</a>
        }
    </div>
</article>
