@model List<Project>
@{
    ViewData["Title"] = "Projects";
}

<section class="projects-grid">
    <h1 class="reveal reveal-left">Projects</h1>
    <div class="grid">
        @{ var i = 0; }
        @foreach (var project in Model)
        {
            var delayClass = i % 3 == 0 ? "" : i % 3 == 1 ? "d1" : "d2";
            i++;
            <div class="project-card reveal reveal-zoom @delayClass">
                @if (!string.IsNullOrEmpty(project.CoverImage))
                {
                    <img class="card-image" src="@project.CoverImage" alt="@project.Title cover" />
                }
                <h3>@project.Title</h3>
                <p>@project.Summary</p>
                <div class="tags">
                    @foreach (var tech in project.TechStack)
                    {
                        <span class="tag">@tech</span>
                    }
                </div>
                <a asp-controller="Projects" asp-action="Details" asp-route-slug="@project.Slug">View details</a>
            </div>
        }
    </div>
</section>
